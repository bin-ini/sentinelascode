     printContributedVariables: true,
     printPostContent: true,
     silentResponse: false,
    )
  }
 stages {
        stage('Build Selection') {
            steps {
                // Use a script block to do custom scripting
                script {
                    decideBuild ("${modified}")
             }
            }
