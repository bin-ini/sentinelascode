//Function which takes String input parameter, and decides the relevant build to trigger
//Input - String filenmae
// Output - Triggers a DSL Job
// A core rule engine implementation - This can be advanced to define more complex scenarios
// This should be scene as a general direction to decide your build filter

def decideBuild(String modifications){
    def jenkinsFileSelected
                    echo "modifiedChanges-${modifications}"
                    if(null=="${modifications}"){
                         error "No Relevant File Selected which should trigger build- something went wrong"
                    }
                   
                    if("${modifications}".toLowerCase().contains('analytics')){
                    //The webhook ability to deploy analytic rules is only provided with ARM templates
                    //The relevant scripts are available, and analytic rules can be deployed manually from the pipeline when non ARM templates are used
                    //The approach is taken to discourage the usage of non ARM templates which otherwise provides multitude of parameter support
                        jenkinsFileSelected = "Pipelines/AnalyticsRulesCICD_ARM_JenkinsFile"
                    }
                    else if ("${modifications}".toLowerCase().contains('hunting')){
                        jenkinsFileSelected = "Pipelines/HuntingRulesCICD_JenkinsFile"
                    }
                    else if ("${modifications}".toLowerCase().contains('onboarding')){
                        jenkinsFileSelected = "Pipelines/OnboardingCICD_JenkinsFile"
                    }
                    else if ("${modifications}".toLowerCase().contains('playbooks')){
                        jenkinsFileSelected = "Pipelines/PlaybooksCICD_JenkinsFile"
                    }
                    else if ("${modifications}".toLowerCase().contains('workbooks')){
                        jenkinsFileSelected = "Pipelines/WorkbooksCICD_JenkinsFile"
                    }
                    else if ("${modifications}".toLowerCase().contains('connectors')){
                        jenkinsFileSelected = "Pipelines/ConnectorsCICD_JenkinsFile"
                    }
                    else{
                        echo "No Jenkins file selected -${modifications}"
                        currentBuild.result = 'ABORTED'
                        error "No Relevant File Selected which should trigger build, try manual approach"
                    }
                    
                    //trigger a DSL job with specific pipeline input which would be required to run the specific job
                    build job: 'SentinelParametrizedJobGenerator', parameters: [[$class: 'StringParameterValue', name: 'jenkinsFileSelected', value: "${jenkinsFileSelected}"]]
}
