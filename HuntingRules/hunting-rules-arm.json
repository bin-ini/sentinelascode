{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspace": {
            "type": "String"
        },
        "query_id": {
            "defaultValue": "[newGuid()]",
            "type": "String"
        },
        "displayname": {
            "type": "string",
            "metadata": {
                "description": "Name for your hunting query"
            }
        },
        "query": {
            "type": "string",
            "metadata": {
                "description": "Type your query here (f.e. SigninLogs | take 10)"
            }
        },
        "tactics": {
            "type": "String",
            "metadata": {
                "description": "Allowed value is a comma separated subset of the following values: DefenseEvasion, Impact, CommandAndControl, Collection, LateralMovement, PreAttack, Exfiltration, Discovery, CredentialAccess, PrivilegeEscalation, Persistence, Execution, InitialAccess"
            }
        }
    },
    "functions": [],
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.OperationalInsights/workspaces/savedSearches",
            "apiVersion": "2020-08-01",
            "name": "[concat(parameters('workspace'), '/',parameters('query_id'))]",
            "properties": {
                "etag": "*",
                "Category": "Hunting Queries",
                "DisplayName": "HuntingRule01", 
                "Query": "SecurityEvent | where EventID == \"4687\" | where CommandLine contains \"-noni -ep bypass $\"",
                "Tags": [
                    {
                        "Name": "description",
                        "Value": "test"
                    },
                    {
                        "Name": "tactics",
                        "Value":  ["Persistence",
                                  "LateralMovement",
                                  "Collection"
                                ]
                    }
                ]
            }
        },
        {
            "type": "Microsoft.OperationalInsights/workspaces/savedSearches",
            "apiVersion": "2020-08-01",
            "name": "[concat(parameters('workspace'), '/',parameters('query_id'))]",
            "properties": {
                "etag": "*",
                "Category": "Hunting Queries",
                "DisplayName": "HuntingRule02", 
                "Query": "SecurityEvent | where EventID == \"4688\" | where CommandLine contains \"-noni -ep bypass $\"",
                "Tags": [
                    {
                        "Name": "description",
                        "Value": "test"
                    },
                    {
                        "Name": "tactics",
                        "Value":  ["Persistence",
                                  "LateralMovement"
                                ]
                    }
                ]
            }
        }
    ],
    "outputs": {}
}
